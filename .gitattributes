# Shell scripts and Pi-side config must stay LF even on Windows checkouts —
# they run under bash/systemd on the Pi.
*.sh              text eol=lf
*.tmpl            text eol=lf
*.conf            text eol=lf
*.network         text eol=lf
*.env             text eol=lf
portal.env.example text eol=lf
*.html            text eol=lf
*.py              text eol=lf
*.service         text eol=lf
*.txt             text eol=lf

# Windows-side driver: CRLF is fine.
*.ps1             text eol=crlf

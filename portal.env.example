# Captive-portal tunables. Copy to portal.env and edit.
#   cp portal.env.example portal.env
# deploy.sh reads portal.env locally (for the Pi's ssh target) and ships it to
# the Pi; setup.sh sources it and renders config/*.tmpl into place.
# portal.env is git-ignored — it may hold a Wi-Fi passphrase.

# --- Pi ssh target (used by deploy.sh only) ---
PI_HOST=raspberrypi.local          # hostname or IP reachable over ETHERNET
PI_USER=pi                         # ssh user with sudo

# --- Wi-Fi AP ---
SSID=Portal
COUNTRY=US                         # ISO 3166-1 alpha-2 regulatory domain
CHANNEL=6                          # 2.4 GHz: pick 1, 6, or 11
# Leave WPA_PASSPHRASE empty for an OPEN network (portal appears with no key).
# Set it (8-63 chars) for WPA2; clients enter the key, then get the portal.
WPA_PASSPHRASE=

# --- Network ---
PORTAL_IP=192.168.4.1
NETMASK=255.255.255.0
PREFIX=24                          # CIDR prefix matching NETMASK
DHCP_START=192.168.4.50
DHCP_END=192.168.4.150
DHCP_LEASE=12h

# --- Interface ---
WLAN_IF=wlan0

# Captive-portal tunables. Copy to portal.env and edit.
#   cp portal.env.example portal.env
# deploy.sh reads portal.env locally (for the Pi's ssh target) and ships it to
# the Pi; setup.sh sources it and renders config/*.tmpl into place.
# portal.env is git-ignored — it may hold a Wi-Fi passphrase.

# --- Pi ssh target (used by deploy.sh only) ---
PI_HOST=raspberrypi.local          # hostname or IP reachable over ETHERNET
PI_USER=pi                         # ssh user with sudo

# --- Wi-Fi AP ---
# NOTE: setup.sh sources this file with the shell, so any value containing
# spaces or shell metacharacters MUST be quoted, e.g. SSID="Not A Honeypot".
SSID=Portal
COUNTRY=US                         # ISO 3166-1 alpha-2 regulatory domain
CHANNEL=6                          # 2.4 GHz: pick 1, 6, or 11
# Leave WPA_PASSPHRASE empty for an OPEN network (portal appears with no key).
# Set it (8-63 chars) for WPA2; clients enter the key, then get the portal.
WPA_PASSPHRASE=

# --- Network ---
PORTAL_IP=192.168.4.1
NETMASK=255.255.255.0
PREFIX=24                          # CIDR prefix matching NETMASK
DHCP_START=192.168.4.50
DHCP_END=192.168.4.150
DHCP_LEASE=12h

# --- Guestbook (optional Flask app) ---
# 1 = install the SQLite guestbook at /guestbook; 0 = portal splash only.
GUESTBOOK=1

# --- Multi-SSID / bait rotation (optional) ---
# Broadcast extra "bait" SSIDs next to the primary SSID above. The rt2800usb
# radio supports up to 8 BSSes on one channel, so up to 7 baits. The bait pool
# lives in ssids.txt (one name per line; copy ssids.txt.example). With no
# ssids.txt you get a single SSID, exactly as before.
SSID_ROTATE=1                # 1 = periodically reshuffle which baits are live
# Each reshuffle restarts hostapd and briefly drops EVERY client (Portal too),
# so keep this generous (>=1h). Fast rotation = clients constantly disconnected.
SSID_ROTATE_INTERVAL=1h     # systemd time: e.g. 30min, 1h, 6h
SSID_BAIT_COUNT=7            # how many baits to broadcast at once (max 7)

# --- Interface ---
WLAN_IF=wlan0

# --- Probe logging (monitor mode) — needs a DEDICATED second radio ---
# Passively logs 802.11 probe-requests: each nearby device's MAC and the SSIDs
# it's searching for. Requires a Wi-Fi adapter used ONLY as a monitor — the AP
# radio can't also monitor (one channel at a time; rt2800usb won't do both).
# Keep this OFF until that second radio exists: turning it on points the daemon
# at MONITOR_IF and flips it to monitor mode, which kills any AP on that radio.
# Intended split once the AR9271 is the AP: rt2800usb -> monitor, AR9271 -> AP.
# View captured data: sudo python3 /opt/portal-probe-logger.py --report
PROBE_LOG=0
MONITOR_IF=wlan1            # the dedicated monitor radio (must NOT equal WLAN_IF)
PROBE_CHANNELS=1,6,11      # 2.4GHz channels to hop across while listening
PROBE_HOP=1                # 1 = channel-hop; 0 = stay on the first channel
PROBE_HOP_INTERVAL=0.5    # seconds to dwell on each channel
PROBE_COMMIT_INTERVAL=5   # seconds between SQLite commits (SD-card friendly)

# --- Deploy ---
# Passwordless sudo for the deploy user. deploy.ps1 runs sudo over a
# non-interactive SSH session (no TTY for a password prompt), so setup.sh
# installs /etc/sudoers.d/011_pi-nopasswd for the user who runs it. The first
# deploy is interactive (ssh -t); this makes every one after unattended.
# Set to 0 to manage sudoers yourself.
NOPASSWD_SUDO=1

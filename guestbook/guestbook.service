[Unit]
Description=Portal guestbook (Flask/gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/guestbook
Environment=GUESTBOOK_DB=/var/lib/portal/guestbook.db
ExecStart=/opt/guestbook/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8080 app:app
Restart=on-failure
RestartSec=2

# Light hardening — the app only needs its own dirs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/portal

[Install]
WantedBy=multi-user.target

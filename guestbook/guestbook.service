[Unit]
Description=Portal guestbook (Flask/gunicorn)
After=network.target

[Service]
Type=simple
User=guestbook
Group=guestbook
WorkingDirectory=/opt/guestbook
# Secrets/config (GUESTBOOK_DB, GUESTBOOK_DUMP_KEY) — written 0600 by setup.sh.
# Leading '-' so a missing file doesn't fail the unit.
EnvironmentFile=-/etc/guestbook.env
ExecStart=/opt/guestbook/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8080 app:app
Restart=on-failure
RestartSec=2

# Hardening — hostile client network. The app only needs its own dirs; it also
# shells out to `ip neigh` (netlink) and reads /run + /var/lib/misc, so we avoid
# RestrictAddressFamilies / SystemCallFilter which would break those.
# The whole filesystem is read-only except the DB dir (and a private /tmp, which
# gunicorn uses for worker heartbeats). /opt/guestbook is root-owned besides.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/portal
UMask=0027
# App dir is read-only, so don't try to write __pycache__ into it.
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
